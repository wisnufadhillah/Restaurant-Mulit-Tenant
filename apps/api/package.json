{
  "name": "@restaurant/api",
  "private": true,
  "scripts": {
    "dev": "tsc && node --watch dist/main.js",
    "watch:types": "tsc --watch",
    "build": "prisma generate && tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.cjs",
    "test:database": "node --test test/database.integration.cjs test/restaurant.integration.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/database/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
