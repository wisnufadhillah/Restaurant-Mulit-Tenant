generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  outlets Outlet[]
  staff Staff[]
  menuItems MenuItem[]
  reservationCreatorSessions ReservationCreatorSession[]
  knowledgeDocuments KnowledgeDocument[]
  @@map("tenants")
}

model Outlet {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name String
  address String
  contactPhone String @map("contact_phone")
  timezone String @default("Asia/Jakarta")
  durationMinutes Int @default(90) @map("duration_minutes")
  minNoticeMinutes Int @default(60) @map("min_notice_minutes")
  maxAdvanceDays Int @default(30) @map("max_advance_days")
  cancelCutoffMinutes Int @default(120) @map("cancel_cutoff_minutes")
  maxPartySize Int @default(12) @map("max_party_size")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([tenantId, id])
  @@index([tenantId])
  tables DiningTable[]
  weeklyHours WeeklyHours[]
  specialHours SpecialHours[]
  reservations Reservation[]
  @@map("outlets")
}

model SpecialHours {
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  date DateTime @db.Date
  openMinute Int? @map("open_minute")
  closeMinute Int? @map("close_minute")
  @@id([tenantId, outletId, date])
  @@map("special_hours")
}

model OperationalAudit {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  staffId String @map("staff_id") @db.Uuid
  staff Staff @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  action String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([tenantId, createdAt])
  @@map("operational_audits")
}

model WeeklyHours {
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  weekday Int
  openMinute Int? @map("open_minute")
  closeMinute Int? @map("close_minute")
  @@id([tenantId, outletId, weekday])
  @@map("weekly_hours")
}

model DiningTable {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  name String
  capacity Int
  isActive Boolean @default(true) @map("is_active")
  reservations Reservation[]
  @@unique([tenantId, outletId, id])
  @@unique([tenantId, outletId, name])
  @@map("dining_tables")
}

model MenuItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name String
  description String
  price Int
  isActive Boolean @default(true) @map("is_active")
  isAvailable Boolean @default(true) @map("is_available")
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("menu_items")
}

model Staff {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  username String
  passwordHash String @map("password_hash")
  role String
  isActive Boolean @default(true) @map("is_active")
  sessions StaffSession[]
  audits OperationalAudit[]
  reservationEvents ReservationEvent[]
  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@map("staff")
}

model Reservation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  tableId String @map("table_id") @db.Uuid
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  table DiningTable @relation(fields: [tenantId, outletId, tableId], references: [tenantId, outletId, id], onDelete: Restrict)
  referenceCode String @map("reference_code")
  managementTokenHash String @map("management_token_hash")
  managementExpiresAt DateTime @map("management_expires_at") @db.Timestamptz(3)
  guestName String @map("guest_name")
  guestPhone String @map("guest_phone")
  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt DateTime @map("end_at") @db.Timestamptz(3)
  partySize Int @map("party_size")
  status String @default("confirmed")
  source String
  idempotencyKey String @map("idempotency_key")
  requestHash String @map("request_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  events ReservationEvent[]
  creatorSessionId String? @map("creator_session_id") @db.Uuid
  creatorSession ReservationCreatorSession? @relation(fields: [tenantId, creatorSessionId], references: [tenantId, id], onDelete: Restrict)
  confirmation ReservationConfirmation?
  managementSessions ReservationManagementSession[]
  @@unique([tenantId, creatorSessionId, id])
  @@unique([tenantId, id])
  @@unique([tenantId, referenceCode])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, outletId, startAt])
  @@map("reservations")
}

model ReservationEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  reservation Reservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict)
  fromStatus String? @map("from_status")
  toStatus String @map("to_status")
  actorType String @map("actor_type")
  staffId String? @map("staff_id") @db.Uuid
  staff Staff? @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  reason String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([tenantId, reservationId, createdAt])
  @@map("reservation_events")
}

model ReservationCreatorSession {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tokenHash String @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  reservations Reservation[]
  confirmations ReservationConfirmation[]
  @@unique([tenantId, id])
  @@index([expiresAt])
  @@map("reservation_creator_sessions")
}

model ReservationConfirmation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  creatorSessionId String @map("creator_session_id") @db.Uuid
  creatorSession ReservationCreatorSession @relation(fields: [tenantId, creatorSessionId], references: [tenantId, id], onDelete: Restrict)
  nonceHash String @unique @map("nonce_hash")
  requestHash String @map("request_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  reservationId String? @map("reservation_id") @db.Uuid
  reservation Reservation? @relation(fields: [tenantId, creatorSessionId, reservationId], references: [tenantId, creatorSessionId, id], onDelete: Restrict)
  @@unique([tenantId, creatorSessionId, reservationId])
  @@index([tenantId, creatorSessionId, expiresAt])
  @@map("reservation_confirmations")
}

model ReservationManagementSession {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  reservation Reservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict)
  tokenHash String @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  @@index([tenantId, reservationId])
  @@map("reservation_management_sessions")
}

model KnowledgeDocument {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  activeRevision Int? @map("active_revision")
  revisions KnowledgeDocumentRevision[] @relation("KnowledgeRevisions")
  active KnowledgeDocumentRevision? @relation("ActiveKnowledgeRevision", fields: [tenantId, id, activeRevision], references: [tenantId, documentId, revision], onDelete: NoAction, onUpdate: NoAction)
  @@unique([tenantId, id])
  @@map("knowledge_documents")
}

model KnowledgeDocumentRevision {
  tenantId String @map("tenant_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  revision Int
  document KnowledgeDocument @relation("KnowledgeRevisions", fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  activeFor KnowledgeDocument[] @relation("ActiveKnowledgeRevision")
  title String
  status String @default("draft")
  contentHash String @map("content_hash")
  approvedHash String? @map("approved_hash")
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
  approvalReference String? @map("approval_reference")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  chunks KnowledgeChunk[]
  @@id([tenantId, documentId, revision])
  @@map("knowledge_document_revisions")
}

model KnowledgeChunk {
  tenantId String @map("tenant_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  revision Int
  position Int
  text String
  documentRevision KnowledgeDocumentRevision @relation(fields: [tenantId, documentId, revision], references: [tenantId, documentId, revision], onDelete: Restrict)
  @@id([tenantId, documentId, revision, position])
  @@map("knowledge_chunks")
}

model StaffSession {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  staffId String @map("staff_id") @db.Uuid
  staff Staff @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  tokenHash String @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  @@index([tenantId, staffId])
  @@index([expiresAt])
  @@map("staff_sessions")
}
