{
  "openapi": "3.1.1",
  "info": {
    "title": "Restaurant API",
    "version": "0.1.0",
    "description": "Implemented local public read-only restaurant catalogue endpoint. Authentication, reservation writes and chat gateway are not part of this contract."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001/api/v1",
      "description": "Local API"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Process liveness; not database or model readiness",
        "responses": {
          "200": {
            "description": "API process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/public/tenants/{slug}/restaurant": {
      "get": {
        "operationId": "getPublicRestaurant",
        "summary": "Read active tenant public profile and active outlets",
        "description": "Slug selects the public tenant catalogue, not private authorization. Only active menu items and available tables are returned.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "example": "demo-padang"
          }
        ],
        "responses": {
          "200": {
            "description": "Current public profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestaurantResponse"
                }
              }
            }
          },
          "404": {
            "description": "Tenant missing, inactive or invalid slug",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Database lookup unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/staff/login": { "post": { "operationId": "staffLogin", "responses": { "200": { "description": "Staff session created" } } } },
    "/staff/logout": { "post": { "operationId": "staffLogout", "responses": { "200": { "description": "Staff session revoked" } } } },
    "/staff/{slug}/menu/{id}": { "patch": { "operationId": "updateStaffMenu", "responses": { "200": { "description": "Menu item updated" } } } },
    "/staff/{slug}/tables/{id}": { "patch": { "operationId": "updateStaffTable", "responses": { "200": { "description": "Dining table updated" } } } },
    "/staff/{slug}/hours/{dayOfWeek}": { "put": { "operationId": "updateStaffHours", "responses": { "200": { "description": "Opening hours updated" } } } }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "restaurant-api"
          }
        }
      },
      "OutletInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "address",
          "contactPhone",
          "timezone",
          "durationMinutes",
          "minNoticeMinutes",
          "maxAdvanceDays",
          "cancelCutoffMinutes",
          "maxPartySize"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer"
          },
          "minNoticeMinutes": {
            "type": "integer"
          },
          "maxAdvanceDays": {
            "type": "integer"
          },
          "cancelCutoffMinutes": {
            "type": "integer"
          },
          "maxPartySize": {
            "type": "integer"
          },
          "menuItems": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MenuItemInfo" }
          },
          "diningTables": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DiningTableInfo" }
          },
          "openingHours": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OpeningHourInfo" }
          }
        }
      },
      "MenuItemInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "price", "description", "isAvailable"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" },
          "isAvailable": { "type": "boolean" }
        }
      },
      "DiningTableInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tableNumber", "capacity", "area", "status"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "tableNumber": { "type": "string" },
          "capacity": { "type": "integer", "minimum": 1 },
          "area": { "type": "string" },
          "status": { "enum": ["available", "reserved", "maintenance"] }
        }
      },
      "OpeningHourInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dayOfWeek", "openMinutes", "closeMinutes", "isOpen"],
        "properties": {
          "dayOfWeek": { "type": "integer", "minimum": 0, "maximum": 6 },
          "openMinutes": { "type": "integer", "minimum": 0, "maximum": 1439 },
          "closeMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "isOpen": { "type": "boolean" }
        }
      },
      "RestaurantResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "retrieved_at",
          "source"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "name",
              "outlets"
            ],
            "properties": {
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "outlets": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OutletInfo"
                }
              }
            }
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "const": "restaurant_api"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
