<mxCell id="c2" value="PK = identitas utama | UK = nilai unik | FK = referensi. Garis menghubungkan baris PK ke baris FK." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="2380" height="32" as="geometry"/></mxCell>
<mxCell id="c3" value="Kotak referensi berulang = tabel yang sama, bukan tabel baru. Setiap panel menampilkan seluruh atribut tabel tujuan." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="2380" height="32" as="geometry"/></mxCell>
