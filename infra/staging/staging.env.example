# Nonsecret Compose interpolation only. Copy privately to .local/staging/compose.env.
# No protocol/path: confirm DNS before choosing API_DOMAIN (proposed api.globaltenant.co.uk).
API_DOMAIN=
# Exact stable https://<project>.vercel.app origin, no trailing slash or preview wildcard.
STAFF_ORIGIN=
# Immutable operator-chosen local release label; retain previous images for rollback.
STAGING_IMAGE_TAG=
# Select and smoke-test explicitly allowlisted free OpenRouter models before rollout.
AGNO_MODEL_ID=
AGNO_ALLOWED_MODELS=
# Mounted secret files are declared in compose.staging.yaml, never values here:
# .local/staging/postgres_password
# .local/staging/assistant_gateway_token
# .local/staging/internal_tool_service_token
# .local/staging/internal_context_secret
# .local/staging/midtrans_server_key (sandbox only)
# .local/staging/openrouter_api_key
