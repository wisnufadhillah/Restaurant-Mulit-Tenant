{
  "name": "restaurant-workspace",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev:web": "node scripts/wait-for-api.cjs && pnpm --filter @restaurant/web dev",
    "dev:api": "pnpm --filter @restaurant/api dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
